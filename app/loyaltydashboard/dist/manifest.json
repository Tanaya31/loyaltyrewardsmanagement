{
	"_version": "1.86.0",
	"sap.app": {
		"id": "loyaltydashboard.loyaltydashboard",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:basic",
			"version": "1.30.0",
			"toolsId": "f73ead4a-60fe-406d-a34d-b8bab47352d3"
		},
		"dataSources": {
			"mainService": {
				"uri": "/loyaltyrewards/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.151.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "loyaltydashboard.loyaltydashboard.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"controlAggregation": "pages",
				"controlId": "app",
				"transition": "slide",
				"type": "View",
				"viewType": "XML",
				"path": "loyaltydashboard.loyaltydashboard.view",
				"async": true,
				"viewPath": "loyaltydashboard.loyaltydashboard.view"
			},
			"routes": [
				{
					"name": "RouteMain",
					"pattern": ":?query:",
					"target": [
						"TargetMain"
					]
				},
				{
					"name": "RouteCustomer",
					"pattern": "customers",
					"target": [
						"TargetCustomer"
					]
				},
				{
					"name": "RouteCustomerDetails",
					"pattern": "customers/{customerID}",
					"target": [
						"TargetCustomerDetails"
					]
				},
				{
					"name": "RouteTransaction",
					"pattern": "transactions",
					"target": "TargetTransaction"
				},
				{
					"name": "RouteRedemption",
					"pattern": "redemptions",
					"target": "TargetRedemption"
				},
				{
					"name": "RouteRewardPolicy",
					"pattern": "reward-policies",
					"target": "TargetRewardPolicy"
				}
			],
			"targets": {
				"TargetMain": {
					"id": "Main",
					"name": "Main"
				},
				"TargetCustomer": {
					"id": "Customer",
					"name": "Customer"
				},
				"TargetCustomerDetails": {
					"id": "CustomerDetails",
					"name": "CustomerDetails"
				},
				"TargetTransaction": {
					"id": "Transaction",
					"name": "Transaction"
				},
				"TargetRedemption": {
					"id": "Redemption",
					"name": "Redemption"
				},
				"TargetRewardPolicy": {
					"id": "RewardPolicy",
					"name": "RewardPolicy"
				}
			}
		},
		"rootView": {
			"viewName": "loyaltydashboard.loyaltydashboard.view.App",
			"type": "XML",
			"id": "App",
			"async": true
		},
		"flexBundle": false
	}
}